{
  "schemaVersion": 1,
  "id": "elytraslot_compat",
  "version": "${version}",
  "name": "Elytra Slot Compat",
  "description": "A mod that adds compatibility with ElytraSlot via configuration.",
  "authors": [
    "Minor2CCh"
  ],
  "contact": {
    "homepage": "https://modrinth.com/project/elytra-slot-compat",
    "issues": "https://github.com/Minor2CCh/elytraslot_compat/issues",
    "sources": "https://github.com/Minor2CCh/elytraslot_compat"
  },
  "license": "LGPL-3.0-only",
  "icon": "icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.Minor2CCh.elytraslot_compat.fabric.ElytraslotCompatFabric"
    ],
    "client": [
      "com.Minor2CCh.elytraslot_compat.fabric.client.ElytraslotCompatFabricClient"
    ]
  },
  "mixins": [
    "elytraslot_compat-common.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.17.2",
    "minecraft": "1.20.1",
    "java": ">=17",
    "fabric-api": "*",
    "elytraslot": "*",
    "trinkets": "*"
  },
  "suggests": {
    "another-mod": "*"
  }
}
